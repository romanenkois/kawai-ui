{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "kawai-ui": {
      "projectType": "library",
      "root": "projects/kawai-ui",
      "sourceRoot": "projects/kawai-ui/src",
      "prefix": "kawai",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/kawai-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/kawai-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/kawai-ui/tsconfig.spec.json"
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "projects/kawai-ui/.storybook",
            "browserTarget": "kawai-ui:build",
            "tsConfig": "projects/kawai-ui/.storybook/tsconfig.json",
            "compodoc": true,
            "compodocArgs": ["-e", "json", "-d", "projects/kawai-ui/.storybook"],
            "styles": [
              "projects/kawai-ui/styles/kawai-theme.css",
              "projects/kawai-ui/.storybook/preview.css"
            ],
            "port": 6006
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "projects/kawai-ui/.storybook",
            "browserTarget": "kawai-ui:build",
            "tsConfig": "projects/kawai-ui/.storybook/tsconfig.json",
            "compodoc": true,
            "compodocArgs": ["-e", "json", "-d", "projects/kawai-ui/.storybook"],
            "styles": [
              "projects/kawai-ui/styles/kawai-theme.css",
              "projects/kawai-ui/.storybook/preview.css"
            ],
            "outputDir": "dist/storybook/kawai-ui"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/kawai-ui/**/*.ts", "projects/kawai-ui/**/*.html"],
            "eslintConfig": "projects/kawai-ui/eslint.config.js"
          }
        }
      }
    },
    "playground": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/playground",
      "sourceRoot": "projects/playground/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/playground/src/main.ts",
            "tsConfig": "projects/playground/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/playground/public"
              }
            ],
            "styles": [
              "projects/kawai-ui/styles/kawai-theme.css",
              "projects/playground/src/styles.scss"
            ],
            "define": {
              "KAWAI_UI_MODE": "\"source\""
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "built": {
              "tsConfig": "projects/playground/tsconfig.app.built.json",
              "styles": [
                "dist/kawai-ui/styles/kawai-theme.css",
                "projects/playground/src/styles.scss"
              ],
              "define": {
                "KAWAI_UI_MODE": "\"built\""
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "playground:build:production"
            },
            "development": {
              "buildTarget": "playground:build:development"
            },
            "built": {
              "buildTarget": "playground:build:development,built"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
