{
  "name": "kawai-ui",
  "version": "0.0.0",
  "private": true,
  "description": "An angular ui library",
  "keywords": [
    "angular",
    "ui library",
    "component",
    "components"
  ],
  "packageManager": "npm@11.19.0",
  "license": "Apache-2.0",
  "repository": {
    "url": "https://github.com/romanenkois/kawai-ui"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve playground",
    "start:built": "ng build kawai-ui && ng serve playground --configuration built",
    "build": "ng build kawai-ui",
    "build:playground": "ng build playground",
    "build:playground:built": "ng build kawai-ui && ng build playground --configuration production,built",
    "watch": "ng build kawai-ui --watch --configuration development",
    "test": "ng test",
    "check:theme": "node scripts/check-theme.mjs",
    "test:a11y": "npm run build-storybook && node scripts/test-a11y.mjs",
    "test:pack": "node scripts/test-pack.mjs",
    "release": "npm run lint && npm test -- --watch=false && npm run check:theme && npm run test:a11y && npm run test:pack && npm publish ./dist/kawai-ui",
    "storybook": "cross-env NODE_ENV=development ng run kawai-ui:storybook",
    "build-storybook": "ng run kawai-ui:build-storybook",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~22.2.6",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.5",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-themes": "^10.6.6",
    "@storybook/angular": "^10.6.6",
    "angular-eslint": "22.6.0",
    "axe-core": "^4.14.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-storybook": "^10.6.6",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "playwright": "^1.65.1",
    "prettier": "^3.8.1",
    "storybook": "^10.6.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
